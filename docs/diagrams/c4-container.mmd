C4Container
  title SchoolSync AI - Container view (target architecture; see README for what is implemented)
  Person(user, "Parent / school admin", "Uploads calendar PDF, reviews events, approves sync")
  System_Boundary(app, "SchoolSync AI (local-first modular monolith)") {
    Container(web, "Web UI", "Next.js, TypeScript, Tailwind", "Upload wizard, legend review, event review, sync preview [NOT YET BUILT]")
    Container(api, "API + pipeline", "Python 3.12, FastAPI, Pydantic v2", "Ingestion, PDF layout, grid/legend/colour, validation, dedup, export [layout + upload IMPLEMENTED]")
    ContainerDb(db, "SQLite", "SQLite (portable to PostgreSQL)", "Imports, events, manifests, audit [NOT YET BUILT]")
    Container(ocr, "OCR adapter", "Tesseract via pytesseract", "Scanned pages [NOT YET BUILT; binary not installed on dev machine]")
  }
  System_Ext(google, "Google Calendar API", "OAuth 2.0")
  System_Ext(msgraph, "Microsoft Graph Calendar API", "OAuth 2.0")
  System_Ext(llm, "Optional LLM (Ollama)", "Schema-validated text interpretation only")
  Rel(user, web, "Uses", "HTTPS")
  Rel(web, api, "JSON/HTTP")
  Rel(api, db, "SQL")
  Rel(api, ocr, "In-process")
  Rel(api, google, "Sync after explicit confirmation", "HTTPS")
  Rel(api, msgraph, "Sync after explicit confirmation", "HTTPS")
  Rel(api, llm, "Optional", "HTTP")
