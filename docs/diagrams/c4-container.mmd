C4Container
  title SchoolSync AI - Container view (status labels reflect the repository today)
  Person(user, "Parent / school admin", "Uploads a calendar PDF, reviews events, approves any sync")
  System_Boundary(app, "SchoolSync AI (modular monolith)") {
    Container(web, "Web UI", "Next.js, TypeScript, Tailwind", "Import, legend review, event review and edit, connect, export and sync. IMPLEMENTED, browser-tested")
    Container(api, "API and pipeline", "Python 3.12, FastAPI, Pydantic v2", "Upload validation, PDF layout, grid and list parsing, legend and colour matching, rules, dedup, export, sync. IMPLEMENTED, 128 tests")
    ContainerDb(db, "SQLite", "SQLite, portable SQL", "Imports, provider manifest, OAuth state, encrypted tokens, audit. IMPLEMENTED")
    Container(ocr, "OCR adapter", "Tesseract via pytesseract", "Scanned pages. NOT BUILT, scanned pages are flagged and skipped")
  }
  System_Ext(google, "Google Calendar API", "OAuth 2.0 with PKCE. Adapter tested on mocked HTTP only")
  System_Ext(msgraph, "Microsoft Graph Calendar API", "NOT IMPLEMENTED")
  Rel(user, web, "Uses", "HTTPS")
  Rel(web, api, "JSON over HTTP")
  Rel(api, db, "SQL")
  Rel(api, ocr, "Planned")
  Rel(api, google, "Writes only after explicit confirmation", "HTTPS")
  Rel(api, msgraph, "Planned")
